{
  "name": "orangeui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:serial": "vitest run --maxWorkers=1 --fileParallelism=false",
    "test:launch": "playwright test --config=playwright.launch.config.ts",
    "test:creative": "playwright test --config=playwright.creative.config.ts",
    "check:copy": "node tests/check-copy.mjs",
    "check:bundle": "node tests/scripts/check-bundle-size.mjs",
    "check:traces": "node tests/scripts/check-source-traces.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o out/storybook",
    "test:browser": "playwright test",
    "test:viewport": "playwright test --config=playwright.viewport.config.ts",
    "test:avatar-redesign": "playwright test --config=playwright.avatar-redesign.config.ts",
    "test:mascot": "playwright test --config=playwright.mascot.config.ts",
    "test:artwork-customizers": "playwright test --config=playwright.artwork-customizers.config.ts",
    "test:motorsport": "playwright test --config=playwright.motorsport.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/axe-core": "^3.0.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "ajv": "^6.15.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.1.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  }
}
