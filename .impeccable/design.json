      "html": "<button type=\"button\" class=\"ds-button ds-primary\">Explore components</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border:1px solid transparent;border-radius:var(--radius-control,14px);background:var(--primary,#ff6a00);color:var(--on-primary,#171717);font:650 14px/1.4 var(--font-body,Arial),sans-serif;box-shadow:0 2px 2px #17171710,inset 0 1px 0 #ffffff30;cursor:pointer;transition:background 180ms,box-shadow 180ms,transform 180ms cubic-bezier(.2,.7,.2,1)}.ds-button:hover{background:var(--primary-hover,#ff821f);box-shadow:0 6px 16px #17171715;transform:translateY(-2px)}.ds-button:focus-visible{outline:3px solid var(--focus,#a64500);outline-offset:3px}.ds-button:active{transform:translateY(1px);box-shadow:none}.ds-button:disabled{background:var(--surface-soft,#f2f2f2);color:var(--muted,#666);cursor:not-allowed}.ds-secondary{background:var(--surface,#fff);color:var(--ink,#171717);border-color:var(--line,#1717172b);box-shadow:var(--soft-shadow,0 3px 8px #17171709)}.ds-ghost{background:transparent;color:var(--ink,#171717);box-shadow:none}.ds-secondary:hover,.ds-ghost:hover{background:var(--surface-soft,#f2f2f2)}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
