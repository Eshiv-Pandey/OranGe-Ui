  "narrative": {
    "northStar": "A pixel soul. A polished finish.",
    "overview": "oRangeUi pairs expressive component artwork with a precise, neutral workspace. The orange pixel character, Geist interface type, restrained borders and clearly differentiated component appearances form the shared identity. The working example gets visual priority; navigation and editing controls remain legible around it.\n\nThe landscape is a scoped expression of that identity: a photographic plate, indigo-blue sky, lavender terrain, peach-lit mist and small teal sparkles. Quiet white lettering and translucent controls preserve the image's depth. This treatment belongs to the landscape landing and its related pricing surface; the component library keeps its established light and dark workspace palettes.\n\nComponent appearances are independent of palette. Polished, Pixelated, Neobrutalism, Retro OS and Terminal retain their own geometry, typography and depth. The landing and playground composition contracts live in their respective .impeccable/surfaces briefs.",
    "keyCharacteristics": [
      "Orange pixel branding alongside readable interface typography.",
      "Neutral light and dark workspaces with a separate appearance choice.",
      "Photographic landscape material with localized, optional motion.",
      "Visible field boundaries, exact editable values and a persistent live preview.",
      "Distinct depth and shape language for all five component appearances."
    ],
    "rules": [
      {
        "name": "The Appearance and Palette Rule",
        "body": "Choose component appearance separately from light or dark palette; preserve both controls and their independent effects.",
        "section": "colors"
      },
      {
        "name": "The Accent Contrast Rule",
        "body": "Use the live semantic accent variables for text, focus and foregrounds. The theme utility derives readable values when the accent changes.",
        "section": "colors"
      },
      {
        "name": "The Readable Controls Rule",
        "body": "Keep editor labels, values and documentation readable at working density. Pixel typography belongs to the pixel appearance and established brand treatments.",
        "section": "typography"
      },
      {
        "name": "The Preview First Rule",
        "body": "Keep the preview visible while editing, reserve space for its dock, and give the inspector its own scroll region when the layout is side by side.",
        "section": "layout"
      },
      {
        "name": "The Scoped Glass Rule",
        "body": "Use glass on the landscape navigation and action, and on the playground dock. Keep the inspector's field boundaries and neutral surfaces intact.",
        "section": "elevation & depth"
      },
      {
        "name": "The Distinct Appearance Rule",
        "body": "Preserve each appearance's complete combination of corners, borders, type and depth; a radius change alone does not express the existing system.",
        "section": "shapes"
      },
      {
        "name": "The Editable Value Rule",
        "body": "Show editable numbers and colors as real fields with labels and focus feedback. Present API descriptions as reading content.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** retain the oRangeUi name and existing orange pixel logo.",
      "**Do** use semantic palette variables so light and dark surfaces, borders, text and focus adapt together.",
      "**Do** preserve the photographic landing composition and keep the central figure clear of scene motion.",
      "**Do** keep all five component appearances available without turning them into palette choices.",
      "**Do** provide visible keyboard focus, descriptive field labels, precise value entry and useful disabled states.",
      "**Do** keep navigation and page copy in HTML and preserve static content when motion or WebGL is unavailable.",
      "**Do** keep component artwork and nature effects visually distinct from the editor that controls them."
    ],
    "donts": [
      "**Don't** replace the library's neutral workspace palette with the landscape's scenic colors.",
      "**Don't** spread glass across editor fields or reduce their visible boundaries.",
      "**Don't** turn the fixed landing figure, readable interface text or navigation into animated scenery.",
      "**Don't** present API documentation as editable controls.",
      "**Don't** remove the palette, appearance, focus or reduced-motion behavior when restyling a component.",
      "**Don't** use em dashes in project copy."
    ]
  }
}
